# Slack bot token with chat:write permission.
SLACK_BOT_TOKEN=xoxb-your-token

# Slack channel ID, for example C0123456789.
SLACK_CHANNEL_ID=C0123456789

# Gemini API key used to generate fresh, non-hardcoded prompts.
GEMINI_API_KEY=your-gemini-api-key

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Cadence: hourly, daily, weekly, or interval.
SCHEDULE_CADENCE=daily

# Used by daily and weekly schedules. 24-hour HH:MM.
SCHEDULE_TIME=09:00

# Used by weekly schedules: monday, tuesday, wednesday, thursday, friday, saturday, sunday.
SCHEDULE_DAY=monday

# Used by interval schedules, in minutes.
SCHEDULE_INTERVAL_MINUTES=60

# Time zone for schedule calculation.
TZ=Europe/London

# Optional style guidance passed into the theme generator.
PROMPT_STYLE=playful, specific, easy for a Slack channel to answer

# Optional path for duplicate-post protection state.
STATE_FILE=.state/last-post.json
